# Copy to .env (local dev) or .env.<APP_ENV> (e.g. .env.production, loaded when APP_ENV=production).
# Precedence: real environment variables > .env.<APP_ENV> > .env. Never commit real values.
ADDR=:8080
# PostgreSQL URL. When set, the server uses Postgres (and runs migrations on start); when empty, the
# in-memory mock store.
# DB_ADDR=postgresql://user:password@host/dbname?sslmode=require
# Plain-HTTP local dev needs this off, or the browser drops the session cookie.
COOKIE_SECURE=false
# Defaults: true for the memory store, false for Postgres. Never enable against a real database:
# the mock accounts have published passwords.
# SEED_MOCK_DATA=true
LOG_LEVEL=info
